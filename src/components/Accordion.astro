---
interface Props {
  title: string;
  claim?: string;
  argument?: string;
  thesis?: string;
  counterTitle?: string;
  hideCounter?: boolean;
}

const {
  title,
  claim,
  argument,
  thesis,
  counterTitle = 'Что на это говорит наука?',
  hideCounter = false,
} = Astro.props;

const argumentParagraphs = argument?.split(/\n\n+/).filter((p) => p.trim()) ?? [];
---

<details class="group rounded-xl border border-sand-300 bg-sand-50 shadow-sm open:shadow-md transition-shadow dark:border-sand-800 dark:bg-sand-900">
  <summary class="flex items-center justify-between gap-4 px-5 py-4">
    <span>
      <span class="block font-medium text-sand-900 dark:text-sand-100">{title}</span>
      {claim && <span class="mt-1 block text-sm text-sand-600 dark:text-sand-400">{claim}</span>}
    </span>
    <span class="chevron shrink-0 text-sand-500 dark:text-sand-400" aria-hidden="true">▸</span>
  </summary>
  <div class="flex flex-col gap-3 px-5 pb-5">
    {thesis && (
      <p class="rounded-lg bg-sand-100 p-4 text-sm leading-relaxed text-sand-800 dark:bg-sand-950 dark:text-sand-200">
        {thesis}
      </p>
    )}
    {argumentParagraphs.length > 0 && (
      <div class="rounded-lg border-l-2 border-clay-500 p-4 text-sand-800 dark:border-clay-300 dark:text-sand-200">
        {argumentParagraphs.map((p) => (
          <p class="mb-3 last:mb-0">{p}</p>
        ))}
      </div>
    )}
    <details class="rounded-lg border border-sand-300 bg-sand-100 dark:border-sand-700 dark:bg-sand-950" open={!hideCounter}>
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-4 py-2.5">
        <span class="text-sm font-semibold text-clay-500 dark:text-clay-300">{counterTitle}</span>
        <span class="chevron shrink-0 text-sand-500 dark:text-sand-400" aria-hidden="true">▸</span>
      </summary>
      <div class="md-content px-4 pb-4 pt-1 text-sand-800 dark:text-sand-200">
        <slot />
      </div>
    </details>
  </div>
</details>
