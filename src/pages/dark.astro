---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';

const base = import.meta.env.BASE_URL;
const entries = (await getCollection('dark')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);
---

<BaseLayout title="Тёмная сторона — Плоская Земля">
  <div class="dark min-h-screen bg-sand-950 text-sand-200">
    <main class="mx-auto max-w-3xl px-6 py-14">
      <header class="mb-10">
        <a href={base} class="text-sm text-sand-400 hover:underline">← На главную</a>
        <h1 class="mt-3 font-display text-3xl font-bold text-sand-100">Тёмная сторона</h1>
        <p class="mt-2 text-sand-400">
          Аргументы плоскоземельщиков против научных доводов.
        </p>
      </header>

      <div id="dark-arguments" class="flex flex-col gap-4">
        {entries.map(async (entry) => {
          const { Content } = await render(entry);
          return (
            <Accordion
              title={entry.data.title}
              claim={entry.data.claim}
              argument={entry.data.argument}
              thesis={entry.data.thesis}
              counterTitle="Что на это возражает наука?"
              hideCounter
            >
              <Content />
            </Accordion>
          );
        })}
      </div>

      {entries.length === 0 && (
        <p class="rounded-xl border border-sand-700 bg-sand-900 p-6 text-sand-400">
          Пока нет аргументов. Добавьте Markdown-файл в <code>src/content/dark/</code>.
        </p>
      )}
    </main>
  </div>
</BaseLayout>
