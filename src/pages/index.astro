---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Плоская Земля: доводы и контр-доводы">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <header
      class="relative overflow-hidden rounded-3xl border border-sand-300 bg-gradient-to-b from-sand-100 to-sand-200 px-6 py-16 text-center shadow-sm"
    >
      <div
        class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full border-2 border-dashed border-sand-400/60"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -left-10 -top-10 h-40 w-40 rounded-full bg-sand-300/60"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -right-20 -bottom-20 h-80 w-80 rounded-full border-2 border-dashed border-sand-400/50"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute right-8 top-8 h-14 w-14 rounded-full bg-gradient-to-br from-clay-300 to-clay-500 opacity-90 shadow-lg"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute bottom-12 right-24 h-9 w-9 rounded-full bg-sand-400/70"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute bottom-10 left-10 h-12 w-12 rounded-full border border-sand-500/40"
        aria-hidden="true"
      ></div>

      <div class="relative">
        <h1 class="font-display text-5xl font-bold tracking-tight text-sand-900 sm:text-6xl">
          Плоская Земля
        </h1>
        <p class="mt-4 font-display text-xl text-sand-700 sm:text-2xl">
          Архив доводов и контр-доводов
        </p>
      </div>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <a
        href={`${base}light/`}
        class="group rounded-2xl border border-sand-300 bg-sand-100 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <span class="text-3xl" aria-hidden="true">☀️</span>
        <h2 class="mt-3 font-display text-2xl font-bold text-sand-900">Светлая сторона</h2>
        <p class="mt-2 text-sm text-sand-700">
          Доводы плоскоземельщиков - и научные контр-аргументы к каждому из них.
        </p>
        <span class="mt-4 inline-block text-sm font-semibold text-clay-500 group-hover:underline">
          Открыть →
        </span>
      </a>

      <a
        href={`${base}dark/`}
        class="group rounded-2xl border border-sand-700 bg-sand-900 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <span class="text-3xl" aria-hidden="true">🌑</span>
        <h2 class="mt-3 font-display text-2xl font-bold text-sand-100">Тёмная сторона</h2>
        <p class="mt-2 text-sm text-sand-400">
          Аргументы против научных доводов - и ответы на них, если захотите.
        </p>
        <span class="mt-4 inline-block text-sm font-semibold text-clay-300 group-hover:underline">
          Открыть →
        </span>
      </a>
    </div>

    <footer class="mt-16 border-t border-sand-300 pt-6 text-center text-xs text-sand-500">
      Новые доводы и контр-аргументы добавляются как Markdown-файлы. Можете кидать
      <a
        href="https://github.com/evgenykon/flat-earth"
        class="ml-1 underline hover:text-sand-700"
        >Pull Request</a
      ><span class="ml-1">со своими примерами.</span>
    </footer>
  </main>
</BaseLayout>
